{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "vite-plugin-pwa/vue"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/integration/**/*.ts",
    "tests/fixtures/**/*.ts",
    "tests/support/**/*.ts",
    "tests/browser/**/*.ts"
  ],
  "exclude": []
}
