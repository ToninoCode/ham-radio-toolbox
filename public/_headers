# HTTP headers for Cloudflare Pages (ADR-0011, ARCHITECTURE.md § 11).
# Rules are combined for every matching path: Cache-Control is therefore set
# only by the specific rules below, never by "/*".
# Limits: 100 rules, 2 000 characters per line.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()

# Content-hashed build assets: cacheable forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

# Service worker: always revalidated, so updates are detected.
/sw.js
  Cache-Control: no-cache
