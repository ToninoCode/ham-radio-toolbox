{
  "name": "ham-radio-toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview",
    "preview:pages": "WRANGLER_SEND_METRICS=false wrangler pages dev dist --ip 127.0.0.1 --log-level warn --show-interactive-dev-session=false",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:deployment": "playwright test --project=cloudflare-pages",
    "icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.149.0"
  }
}
